<!DOCTYPE html>
<html lang="fr">
<%- include('layouts/header'); -%>
<body class="bg-light">
    <%- include('layouts/navbar'); -%>
    <div class="container mt-5 pt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white text-center py-4">
                        <h3 class="mb-0 fw-bold">Creer un compte</h3>
                    </div>
                    <div class="card-body p-5">
                        <% if(errors != null && errors.length > 0) { %>
                            <div class="alert alert-danger rounded-3">
                                <ul class="mb-0">
                                    <% for(var i = 0; i < errors.length; i++){ %>
                                        <li><%= errors[i] %></li>
                                    <% } %>
                                </ul>
                            </div>
                        <% } %>
                        <form action="/users/register" method="POST">
                            <div class="mb-4">
                                <label class="form-label text-muted fw-bold">Nom d'utilisateur</label>
                                <input type="text" class="form-control form-control-lg bg-light" name="username" value="<%= username %>" required>
                            </div>
                            <div class="mb-5">
                                <label class="form-label text-muted fw-bold">Mot de passe</label>
                                <input type="password" class="form-control form-control-lg bg-light" name="password" value="<%= password %>" required>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">Rejoindre le blog</button>
                            </div>
                        </form>
                        <div class="text-center mt-4">
                            <a href="/auth/login" class="text-decoration-none text-muted">Deja un compte ? <span class="text-primary fw-bold">Se connecter</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('layouts/footer'); -%>
    <%- include('layouts/scripts'); -%>
</body>
</html>