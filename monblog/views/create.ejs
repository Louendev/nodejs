<!DOCTYPE html>
<html lang="fr">
<%- include('layouts/header'); -%>
<body class="bg-light">
    <%- include('layouts/navbar'); -%>
    <div class="container mt-5 pt-3 mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-header bg-dark text-white text-center py-4">
                        <h2 class="mb-0 fw-bold">Rediger un nouvel article</h2>
                    </div>
                    <div class="card-body p-5">
                        <form action="/posts/store" method="POST" enctype="multipart/form-data">
                            <div class="mb-4">
                                <label class="form-label fw-bold fs-5">Titre de l'article</label>
                                <input type="text" class="form-control form-control-lg bg-light border-0" name="title" placeholder="Tapez un titre accrocheur..." required>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold fs-5">Image de couverture</label>
                                <input type="file" class="form-control form-control-lg bg-light border-0" name="image" accept="image/*" required>
                            </div>
                            <div class="mb-5">
                                <label class="form-label fw-bold fs-5">Contenu (Texte, Liens, etc.)</label>
                                <textarea class="form-control" id="body" name="body" required></textarea>
                                <script>
                                    .ready(function() {
                                        #body.summernote({ 
                                            height: 400,
                                            placeholder: 'Racontez votre histoire ici...',
                                            toolbar: [
                                                ['style', ['style']],
                                                ['font', ['bold', 'italic', 'underline', 'clear']],
                                                ['color', ['color']],
                                                ['para', ['ul', 'ol', 'paragraph']],
                                                ['table', ['table']],
                                                ['insert', ['link', 'picture', 'video']],
                                                ['view', ['fullscreen', 'codeview']]
                                            ]
                                        });
                                    });
                                </script>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold fs-5 shadow">Publier l'article maintenant</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('layouts/footer'); -%>
    <%- include('layouts/scripts'); -%>
</body>
</html>